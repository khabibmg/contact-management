{
  "rewrites": [
    {
      "source": "/users",
      "destination": "https://contact-management-khabib2.vercel.app/users"
    },
    {
      "source": "/users/:match*",
      "destination": "https://contact-management-khabib2.vercel.app/users/:match*"
    },
    {
      "source": "/api/:match*",
      "destination": "https://contact-management-khabib2.vercel.app/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}